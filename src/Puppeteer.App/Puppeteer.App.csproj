<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Puppeteer.Core\Puppeteer.Core.csproj" />
    <ProjectReference Include="..\Puppeteer.Infrastructure\Puppeteer.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.8.7</Version>
    <AssemblyVersion>0.8.7.0</AssemblyVersion>
    <FileVersion>0.8.7.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The self-contained bundle carries the whole .NET + WPF runtime; leaving it uncompressed makes
         a ~180 MB single file. Compressing the embedded payload roughly halves the download and the
         installed size, at the cost of a one-time decompression on first launch. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF owns the window and DPI lifecycle; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Only for the notification-area icon; WPF has no tray primitive of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationDefaultFont>Segoe UI</ApplicationDefaultFont>
  </PropertyGroup>

  <!-- UseWindowsForms adds System.Drawing and System.Windows.Forms as global usings, which then
       collide with WPF's Size, Point, Brush, KeyEventArgs and friends across the whole app. Drop the
       global usings; the one file that needs WinForms imports it explicitly. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup><Resource Include="Assets\icon.png" /><Resource Include="Assets\logo.png" /></ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\icons\*.svg" Link="Assets\icons\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
