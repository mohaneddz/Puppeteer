<UserControl x:Class="Puppeteer.App.Controls.ProjectCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             MouseDoubleClick="Card_MouseDoubleClick">
  <UserControl.Resources>
    <Style x:Key="CardLink" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Action" Background="Transparent" Padding="8,4" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter x:Name="Label" VerticalAlignment="Center">
                <ContentPresenter.RenderTransform><TranslateTransform/></ContentPresenter.RenderTransform>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Action" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter TargetName="Action" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="3" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Action" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Action" Property="Background" Value="{StaticResource AccentGlowBrush}"/>
                <Setter TargetName="Label" Property="Opacity" Value="0.7"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <!-- No card-level tooltip: it would shadow the per-element tooltips (path, status, actions) that
       carry the information a hover is actually asking for. -->
  <Border x:Name="Card" Padding="{Binding DataContext.CardPadding, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,14,14" BorderThickness="1" CornerRadius="12" Cursor="Hand">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Effect">
              <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
              </Setter.Value>
            </Setter>
          </Trigger>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="46" Height="46" VerticalAlignment="Top" ClipToBounds="True">
          <Border CornerRadius="{Binding Converter={StaticResource ProjectIconShape}}" Background="{Binding Converter={StaticResource ProjectIconTint}}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
          <TextBlock Text="{Binding PrimaryTechnology, Converter={StaticResource TechMono}}"
                     Foreground="{Binding PrimaryTechnology, Converter={StaticResource TechBrush}}"
                     FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Visibility="{Binding Converter={StaticResource IconFallbackVis}}"/>
          <Rectangle RadiusX="{Binding Converter={StaticResource ProjectIconRadius}}" RadiusY="{Binding Converter={StaticResource ProjectIconRadius}}"
                     Visibility="{Binding IconFill, Converter={StaticResource BoolVis}}">
            <Rectangle.Fill><ImageBrush ImageSource="{Binding Converter={StaticResource ProjectIcon}}" Stretch="UniformToFill"/></Rectangle.Fill>
          </Rectangle>
          <Image Source="{Binding Converter={StaticResource ProjectIcon}}" Width="27" Height="27" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding IconFill, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="13,1,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Converter={StaticResource Breadcrumb}}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
          <Path Style="{StaticResource IconPath}" Data="{Binding Converter={StaticResource LifecycleStatusIcon}}" Width="14" Height="14"
                Stroke="{Binding Converter={StaticResource LifecycleStatusBrush}}" Margin="0,0,8,0"
                ToolTip="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource NullVis}}"/>
          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBranch}" Width="13" Height="13" Stroke="{StaticResource SuccessBrush}" Margin="0,0,7,0"
                ToolTip="Git repository" Visibility="{Binding Git, Converter={StaticResource NullVis}}"/>
          <Path Data="{StaticResource IconStar}" Fill="{StaticResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                Visibility="{Binding Id, Converter={StaticResource Pinned}}"/>
          <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,1,0,0"
                   Fill="{Binding Converter={StaticResource StatusBrush}}"
                   ToolTip="{Binding Converter={StaticResource StatusTip}}"
                   Visibility="{Binding Converter={StaticResource StatusVis}}"/>
        </StackPanel>
      </Grid>

      <!-- Tech badges (capped so the fixed-height card never clips; full stack is in the inspector) -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{Binding DataContext.CardGap, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border Style="{StaticResource TechnologyBadge}" Margin="0,0,6,0">
          <TextBlock Text="{Binding Converter={StaticResource ProjectType}}" Style="{StaticResource TechnologyBadgeText}"/>
        </Border>
        <ItemsControl ItemsSource="{Binding Technologies, Converter={StaticResource Take}, ConverterParameter=3}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource TechnologyBadge}" Margin="0,0,6,0">
                <TextBlock Text="{Binding}" Style="{StaticResource TechnologyBadgeText}"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Technologies.Count, Converter={StaticResource MoreCount}, ConverterParameter=3}"
                   Style="{StaticResource TechnologyBadgeText}" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Footer -->
      <Border Grid.Row="2" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Margin="{Binding DataContext.CardGap, RelativeSource={RelativeSource AncestorType=Window}}" Padding="0,10,0,0">
        <Grid>
          <Button Style="{StaticResource CardLink}" HorizontalAlignment="Stretch" Margin="-8,-2,32,-2" ToolTip="Open a terminal in this project's folder"
                  Command="{Binding DataContext.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTerminal}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}"/>
              <TextBlock Text="Open Terminal" Foreground="{StaticResource AccentBrush}" FontSize="12.5" FontWeight="Medium" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="KebabButton" Style="{StaticResource IconButton}" Width="26" Height="24" HorizontalAlignment="Right"
                  Click="Kebab_Click" ToolTip="More actions"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
              <Ellipse Width="3.4" Height="3.4" Fill="{StaticResource MutedTextBrush}" Margin="0,1.4"/>
              <Ellipse Width="3.4" Height="3.4" Fill="{StaticResource MutedTextBrush}" Margin="0,1.4"/>
              <Ellipse Width="3.4" Height="3.4" Fill="{StaticResource MutedTextBrush}" Margin="0,1.4"/>
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Pin / Unpin" Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconStar}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Open Terminal" Command="{Binding PlacementTarget.Tag.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconTerminal}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Open Folder" Command="{Binding PlacementTarget.Tag.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Open in IDE" Command="{Binding PlacementTarget.Tag.OpenIdeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconCode}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Copy Path" Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Archive / Restore" Command="{Binding PlacementTarget.Tag.ToggleArchivedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconArchive}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Hide / Show project" Command="{Binding PlacementTarget.Tag.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconEyeOff}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Delete project…" Command="{Binding PlacementTarget.Tag.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconTrash}" Width="14" Height="14" Stroke="{StaticResource DangerBrush}"/></MenuItem.Icon></MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
