<UserControl x:Class="Puppeteer.App.Controls.ProjectInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Puppeteer.App.Controls">
  <Grid>
    <!-- Empty state -->
    <TextBlock Text="Select a project" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{Binding SelectedProject, Converter={StaticResource NullVis}, ConverterParameter=Inverse}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,4,18,22"
                  Visibility="{Binding SelectedProject, Converter={StaticResource NullVis}}">
      <StackPanel>
        <!-- Header -->
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="52" Height="52" VerticalAlignment="Top" ClipToBounds="True">
            <Border CornerRadius="{Binding SelectedProject, Converter={StaticResource ProjectIconShape}}" Background="{Binding SelectedProject, Converter={StaticResource ProjectIconTint}}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
            <TextBlock Text="{Binding SelectedProject.PrimaryTechnology, Converter={StaticResource TechMono}}"
                       Foreground="{Binding SelectedProject.PrimaryTechnology, Converter={StaticResource TechBrush}}"
                       FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding SelectedProject, Converter={StaticResource IconFallbackVis}}"/>
            <Rectangle RadiusX="{Binding SelectedProject, Converter={StaticResource ProjectIconRadius}}" RadiusY="{Binding SelectedProject, Converter={StaticResource ProjectIconRadius}}"
                       Visibility="{Binding SelectedProject.IconFill, Converter={StaticResource BoolVis}}">
              <Rectangle.Fill><ImageBrush ImageSource="{Binding SelectedProject, Converter={StaticResource ProjectIcon}}" Stretch="UniformToFill"/></Rectangle.Fill>
            </Rectangle>
            <Image Source="{Binding SelectedProject, Converter={StaticResource ProjectIcon}}" Width="31" Height="31" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding SelectedProject.IconFill, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
          </Grid>
          <StackPanel Grid.Column="1" Margin="14,2,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedProject.Name}" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <!-- Grid, not a horizontal StackPanel: a StackPanel measures its children against infinite
                 width, so the path never ellipsizes and shoves the copy button past the panel edge. -->
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding SelectedProject.Path}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProject.Path}"/>
              <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="22" Height="22" Margin="5,0,0,0" ToolTip="Copy path"
                      Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedProject}">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}" Width="13" Height="13" Stroke="{StaticResource FaintBrush}"/>
              </Button>
            </Grid>
          </StackPanel>
          <Ellipse Grid.Column="2" Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,0,0"
                   Fill="{Binding SelectedProject, Converter={StaticResource StatusBrush}}"
                   ToolTip="{Binding SelectedProject, Converter={StaticResource StatusTip}}"
                   Visibility="{Binding SelectedProject, Converter={StaticResource StatusVis}}"/>
        </Grid>

        <!-- Type / Category meta -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Border Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="9,4" Margin="0,0,7,0">
            <TextBlock Text="{Binding SelectedProject, Converter={StaticResource ProjectType}}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
          </Border>
          <Border Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="9,4"
                  Visibility="{Binding SelectedProject.Category, Converter={StaticResource NullVis}}">
            <TextBlock Text="{Binding SelectedProject.Category}" FontSize="11.5" Foreground="{StaticResource AccentBrush}"/>
          </Border>
        </StackPanel>

        <!-- Name -->
        <TextBlock Text="Name" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
        <TextBox Text="{Binding SelectedProjectName, UpdateSourceTrigger=LostFocus}"
                 ToolTip="Shown instead of the folder name. Clear it to go back to the folder's own name."/>

        <!-- Stack -->
        <TextBlock Text="Stack" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
        <ItemsControl ItemsSource="{Binding SelectedProject.Technologies}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource TechnologyBadge}" Margin="0,0,7,7">
                <TextBlock Text="{Binding}" Style="{StaticResource TechnologyBadgeText}"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Actions -->
        <Button Style="{StaticResource AccentOutlineButton}" Command="{Binding OpenTerminalCommand}" Margin="0,16,0,0" Padding="13,11">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTerminal}" Width="16" Height="16" Stroke="{StaticResource AccentBrush}"/>
            <TextBlock Text="Open Terminal" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>
        <Grid Margin="0,9,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="9"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Command="{Binding OpenFolderCommand}" Padding="10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}" Width="15" Height="15"/>
              <TextBlock Text="Open Folder" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Command="{Binding OpenIdeCommand}" Padding="10,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCode}" Width="15" Height="15"/>
              <TextBlock Text="Open in IDE" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
        <Button Command="{Binding TogglePinCommand}" CommandParameter="{Binding SelectedProject}" Margin="0,9,0,0" Padding="10,10">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconStar}" Width="15" Height="15" Stretch="Uniform" Fill="{StaticResource AccentBrush}"
                  Visibility="{Binding SelectedProject.Id, Converter={StaticResource Pinned}}"/>
            <Path Data="{StaticResource IconStar}" Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.4" Fill="Transparent"
                  Visibility="{Binding SelectedProject.Id, Converter={StaticResource Pinned}, ConverterParameter=Inverse}"/>
            <TextBlock Text="Pin to top" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- Commands -->
        <StackPanel Visibility="{Binding SelectedProject.Presets.Count, Converter={StaticResource CountVis}}">
          <TextBlock Text="Commands" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
          <ItemsControl ItemsSource="{Binding SelectedProject.Presets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,0,7" Padding="12,9" HorizontalContentAlignment="Stretch"
                        Command="{Binding DataContext.RunPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" ToolTip="{Binding Command}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTerminal}" Width="14" Height="14" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                    <TextBlock Grid.Column="2" Text="{Binding Command}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Git -->
        <StackPanel Visibility="{Binding SelectedProject.Git, Converter={StaticResource NullVis}}">
          <TextBlock Text="Git" Style="{StaticResource SectionTitle}" Margin="0,26,0,12"/>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBranch}" Width="15" Height="15" Stroke="{StaticResource TextDimBrush}"/>
              <TextBlock Text="{Binding SelectedProject.Git.Branch, StringFormat=Branch: {0}}" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
            </StackPanel>
            <Border Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Left" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" Visibility="{Binding SelectedProject.Git.UpToDate, Converter={StaticResource BoolVis}}">
              <TextBlock Text="No local changes" FontSize="11" Foreground="{StaticResource SuccessBrush}"
                         Visibility="{Binding SelectedProject.Git.UpToDate, Converter={StaticResource BoolVis}}"/>
            </Border>
          </Grid>
          <Grid Margin="0,10,0,0" Visibility="{Binding SelectedProject.Git.RemoteUrl, Converter={StaticResource NullVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Repository" Style="{StaticResource MutedText}" FontSize="11"/>
              <TextBlock Text="{Binding SelectedProject.Git.RemoteUrl}" Margin="0,2,8,0" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedProject.Git.RemoteUrl}"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="6,0,0,0"
                    VerticalAlignment="Center" Visibility="{Binding SelectedProject.Git.GitHubVisibility, Converter={StaticResource NullVis}}">
              <TextBlock Text="{Binding SelectedProject.Git.GitHubVisibility}" FontSize="10.5" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="7,0,0,0" VerticalAlignment="Center">
              <Button Style="{StaticResource CardLinkButton}" Padding="5" ToolTip="Copy repository remote"
                      Command="{Binding CopyRepositoryCommand}" CommandParameter="{Binding SelectedProject}">
                <TextBlock Text="Copy" FontSize="11"/>
              </Button>
              <Button Style="{StaticResource CardLinkButton}" Padding="5" ToolTip="Open repository in browser"
                      Command="{Binding OpenRepositoryCommand}" CommandParameter="{Binding SelectedProject}">
                <TextBlock Text="Browse" FontSize="11"/>
              </Button>
            </StackPanel>
          </Grid>
          <Grid Margin="0,14,0,8">
            <TextBlock Text="Changes" Style="{StaticResource MutedText}"/>
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
              <Run Text="{Binding SelectedProject.Git.ModifiedFileCount, Mode=OneWay}"/><Run Text=" local changes"/>
            </TextBlock>
          </Grid>
          <ItemsControl ItemsSource="{Binding SelectedProject.Git.Files}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextDimBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                  <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,2,0,6" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Foreground="{StaticResource FaintBrush}"
                     Visibility="{Binding HasMoreGitFiles, Converter={StaticResource BoolVis}}">
            <Run Text="+"/><Run Text="{Binding MoreGitFileCount, Mode=OneWay}"/><Run Text=" more"/>
          </TextBlock>
        </StackPanel>
        <StackPanel Visibility="{Binding SelectedProject.Git, Converter={StaticResource NullVis}, ConverterParameter=Inverse}">
          <TextBlock Text="Repository" Style="{StaticResource SectionTitle}" Margin="0,26,0,7"/>
          <TextBlock Text="No Git repository detected in this project." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Sessions -->
        <StackPanel Visibility="{Binding SelectedProject.Sessions, Converter={StaticResource NullVis}}">
          <Grid Margin="0,26,0,12">
            <TextBlock Text="Sessions" Style="{StaticResource SectionTitle}"/>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" FontSize="12">
              <Run Text="{Binding SelectedProject.RunningSessionCount, Mode=OneWay}"/><Run Text=" running"/>
            </TextBlock>
          </Grid>
          <ItemsControl ItemsSource="{Binding SelectedProject.Sessions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,11">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="11,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                  <TextBlock Grid.Column="2" Text="{Binding Command}" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Duration}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <local:ProjectDocPanel/>

        <!-- Project icon -->
        <TextBlock Text="Project Icon" Style="{StaticResource SectionTitle}" Margin="0,26,0,12"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Command="{Binding ChangeIconCommand}" Padding="6,9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPen}" Width="13" Height="13"/>
              <TextBlock Text="Change" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Command="{Binding FindIconCommand}" Padding="6,9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}" Width="13" Height="13"/>
              <TextBlock Text="Find" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Command="{Binding ResetIconCommand}" Padding="6,9">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" Width="13" Height="13"/>
              <TextBlock Text="Reset" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Button>
        </Grid>
        <CheckBox Content="Fill icon container" IsChecked="{Binding IconFillsContainer}" Margin="2,11,0,0"
                  ToolTip="Crops the icon to cover the full tile instead of fitting it inside."/>
        <Grid Margin="2,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
          <TextBlock Text="Icon shape" Style="{StaticResource SettingLabel}" VerticalAlignment="Center"/>
          <ItemsControl Grid.Column="1" ItemsSource="{Binding IconShapeOptions}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.SetIconShapeCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ProjectInspector}}}"
                        CommandParameter="{Binding}" Padding="3" Margin="2,0,0,0" ToolTip="{Binding}">
                  <Border Width="24" Height="24" Background="{StaticResource ChipBrush}"
                          CornerRadius="{Binding Converter={StaticResource ProjectIconShape}}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                          <DataTrigger Value="True">
                            <DataTrigger.Binding>
                              <MultiBinding Converter="{StaticResource IconShapeSelected}">
                                <Binding/>
                                <Binding Path="DataContext.IconShape" RelativeSource="{RelativeSource AncestorType={x:Type local:ProjectInspector}}"/>
                              </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <!-- Icon candidates -->
        <ItemsControl ItemsSource="{Binding IconCandidates}" Margin="0,12,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.ChooseCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}" Width="66" Height="66" Margin="0,0,8,8" Padding="0" ToolTip="{Binding Path}">
                <Image Source="{Binding Path, Converter={StaticResource IconPathSource}}" Width="34" Height="34" Stretch="Uniform"/>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <local:ProjectDocEditor/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
