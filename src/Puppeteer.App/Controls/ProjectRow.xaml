<UserControl x:Class="Puppeteer.App.Controls.ProjectRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             MouseDoubleClick="Row_MouseDoubleClick">
  <!-- The list view's row. Reusing the grid card here stretched a 180px-tall card across the full
       width, so list mode fitted fewer projects on screen than the grid it was meant to condense. -->
  <Border Padding="12,9" Margin="0,0,0,6" BorderThickness="1" CornerRadius="10" Background="{StaticResource CardBrush}" Cursor="Hand">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
          </Trigger>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="2*" MinWidth="160"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Grid Width="34" Height="34" VerticalAlignment="Center">
        <Border CornerRadius="9" Background="{Binding PrimaryTechnology, Converter={StaticResource TechTint}}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
        <TextBlock Text="{Binding PrimaryTechnology, Converter={StaticResource TechMono}}"
                   Foreground="{Binding PrimaryTechnology, Converter={StaticResource TechBrush}}"
                   FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding Converter={StaticResource IconFallbackVis}}"/>
        <Image Source="{Binding Converter={StaticResource ProjectIcon}}" Width="20" Height="20" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>
      </Grid>

      <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconStar}" Fill="{StaticResource AccentBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                Visibility="{Binding Id, Converter={StaticResource Pinned}}"/>
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Text="{Binding Converter={StaticResource Breadcrumb}}" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,1,0,0"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
      </StackPanel>

      <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Technologies, Converter={StaticResource Take}, ConverterParameter=3}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource TechnologyBadge}" Margin="0,0,6,0" Padding="8,3">
              <TextBlock Text="{Binding}" Style="{StaticResource TechnologyBadgeText}" FontSize="11"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center"
                 Fill="{Binding Converter={StaticResource StatusBrush}}"
                 ToolTip="{Binding Converter={StaticResource StatusTip}}"
                 Visibility="{Binding Converter={StaticResource StatusVis}}"/>
        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Open a terminal here"
                Command="{Binding DataContext.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTerminal}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}"/>
        </Button>
        <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Open in Explorer"
                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">
          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}" Width="15" Height="15"/>
        </Button>
        <Button Style="{StaticResource IconButton}" Width="26" Height="30" Click="Kebab_Click" ToolTip="More actions"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <Ellipse Width="3.4" Height="3.4" Fill="{StaticResource MutedTextBrush}" Margin="0,1.4"/>
            <Ellipse Width="3.4" Height="3.4" Fill="{StaticResource MutedTextBrush}" Margin="0,1.4"/>
            <Ellipse Width="3.4" Height="3.4" Fill="{StaticResource MutedTextBrush}" Margin="0,1.4"/>
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Pin / Unpin" Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
              <MenuItem Header="Open Terminal" Command="{Binding PlacementTarget.Tag.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
              <MenuItem Header="Open in IDE" Command="{Binding PlacementTarget.Tag.OpenIdeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
              <MenuItem Header="Copy Path" Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
