<UserControl x:Class="Puppeteer.App.Controls.DocCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Puppeteer.App.Converters">
  <UserControl.Resources>
    <conv:DocStatusBrushConverter x:Key="DocStatusBrush"/>
    <conv:DriftVisibilityConverter x:Key="DriftVis"/>
  </UserControl.Resources>
  <Border x:Name="Card" Style="{StaticResource PanelCard}" Padding="15,13" Margin="0,0,12,12" Cursor="Hand"
          MouseLeftButtonUp="Card_Click" ToolTip="Click to inspect this project">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Name + status. The warning icon sits at the top-right and carries the drift detail on hover,
           instead of a line of alarming text taking a row of the card. -->
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Status, Converter={StaticResource DocStatusBrush}}"/>
            <TextBlock Text="{Binding Name}" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
          </StackPanel>
          <Border Grid.Column="1" VerticalAlignment="Top" Margin="6,-1,0,0" Padding="2" Background="Transparent"
                  ToolTip="{Binding DriftDetail}" ToolTipService.ShowDuration="20000"
                  Visibility="{Binding NeedsWriteup, Converter={StaticResource DriftVis}}">
            <Path Data="{StaticResource IconWarning}" Width="14" Height="14" Stretch="Uniform"
                  Stroke="{StaticResource AccentBrightBrush}" StrokeThickness="1.6"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Border Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2">
            <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{Binding Status, Converter={StaticResource DocStatusBrush}}"/>
          </Border>
          <Border Margin="6,0,0,0" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2"
                  Visibility="{Binding HasIndexNote, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding IndexNote}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}"/>
          </Border>
          <Border Margin="6,0,0,0" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="7,2"
                  Visibility="{Binding HasReadme, Converter={StaticResource BoolVis}}" ToolTip="{Binding ReadmePath}">
            <TextBlock Text="README" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}"/>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- Summary + next step -->
      <StackPanel Grid.Row="1" Margin="0,10,0,0">
        <!-- A fixed line box, so an overlong summary is cut between lines instead of through one:
             WPF trims horizontally per line and will happily clip a line in half vertically. -->
        <TextBlock Text="{Binding CardSummary}" Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap"
                   LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="48" ToolTip="{Binding Summary}"/>
        <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Visibility="{Binding HasNextStep, Converter={StaticResource BoolVis}}">
          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="10" Height="10"
                Stroke="{StaticResource AccentBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding CardNextStep}" Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                     TextWrapping="Wrap" LineHeight="15" LineStackingStrategy="BlockLineHeight" MaxHeight="30" ToolTip="{Binding NextStep}"/>
        </StackPanel>
      </StackPanel>

      <!-- Actions. Inspecting is the whole card's click; the drift now lives in the top-right icon. -->
      <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
        <Button Style="{StaticResource AccentOutlineButton}" Padding="10,5" ToolTip="Read this project's doc and README"
                Command="{Binding DataContext.OpenReaderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}">
          <TextBlock Text="Read" FontSize="11.5"/>
        </Button>
        <Button Margin="6,0,0,0" Padding="10,5" ToolTip="Write a starter doc for this project"
                Command="{Binding DataContext.CreateDocCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" Visibility="{Binding HasDoc, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
          <TextBlock Text="Create doc" FontSize="11.5"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
