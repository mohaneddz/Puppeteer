<UserControl x:Class="Puppeteer.App.Controls.DocsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Puppeteer.App.Converters">
  <UserControl.Resources>
    <conv:DocStatusBrushConverter x:Key="DocStatusBrush"/>
    <conv:DriftVisibilityConverter x:Key="DriftVis"/>
    <!-- The window's BareList lives in Window.Resources, which a separately parsed UserControl
         cannot reach with StaticResource; the list needs its own. -->
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="26,20,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Docs" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding DocsSummary}" VerticalAlignment="Center" Margin="14,8,0,0" Style="{StaticResource MutedText}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Command="{Binding ReloadDocsCommand}" Padding="12,8" ToolTip="Re-read every doc from disk">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" Width="13" Height="13"/>
            <TextBlock Text="Reload" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding SyncAllDocFactsCommand}" Margin="8,0,0,0" Padding="12,8"
                ToolTip="Rewrite every linked doc's Location, Stack and Last activity from the repo. Prose is left alone.">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBranch}" Width="13" Height="13"/>
            <TextBlock Text="Sync facts" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding OpenDocsFolderCommand}" Margin="8,0,0,0" Padding="12,8" ToolTip="Open the docs folder in Explorer">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}" Width="13" Height="13"/>
            <TextBlock Text="Open folder" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Filters -->
    <Grid Grid.Row="1" Margin="0,0,0,14" Visibility="{Binding HasVault, Converter={StaticResource BoolVis}}">
      <StackPanel Orientation="Horizontal">
        <ComboBox Width="170" ItemsSource="{Binding DocFilters}" SelectedItem="{Binding DocFilter}"/>
        <Border Margin="9,0,0,0" Width="240" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,0">
          <Grid>
            <TextBlock Text="Filter docs…" Style="{StaticResource MutedText}" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding DocSearch, Converter={StaticResource EmptyVis}}"/>
            <TextBox Text="{Binding DocSearch, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                     Padding="0,7" VerticalContentAlignment="Center"/>
          </Grid>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Empty: no vault connected -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                Visibility="{Binding HasVault, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDoc}" Width="28" Height="28" Stroke="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
      <TextBlock Text="No docs folder connected" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
      <TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                 Text="Point Puppeteer at the folder where you keep one markdown doc per project. It reads what is already there, and writes back only what you ask it to."/>
      <Button Command="{Binding ChooseDocsFolderCommand}" Style="{StaticResource AccentOutlineButton}" Margin="0,16,0,0" Padding="14,10" HorizontalAlignment="Center">
        <TextBlock Text="Choose folder" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
      </Button>
    </StackPanel>

    <!-- Rows -->
    <ListBox Grid.Row="2" Style="{StaticResource PlainList}" ItemsSource="{Binding DocEntries}"
             ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
             Visibility="{Binding HasVault, Converter={StaticResource BoolVis}}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource PanelCard}" Padding="16,14" Margin="0,0,0,9">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,6,0,0"
                       Fill="{Binding Status, Converter={StaticResource DocStatusBrush}}" ToolTip="{Binding Status}"/>
              <StackPanel Grid.Column="1" Margin="14,0,14,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center"/>
                  <Border Margin="10,0,0,0" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource DocStatusBrush}}"/>
                  </Border>
                  <TextBlock Text="{Binding LinkNote}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                             Foreground="{StaticResource FaintBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasNextStep, Converter={StaticResource BoolVis}}">
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="11" Height="11"
                        Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding NextStep}" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding DriftSummary}" Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource AccentBrightBrush}"
                           Visibility="{Binding NeedsWriteup, Converter={StaticResource DriftVis}}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Activity}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" FontSize="11.5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                  <Button Padding="10,6" ToolTip="Open this doc in your editor"
                          Command="{Binding DataContext.OpenDocCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" Visibility="{Binding HasDoc, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Open doc" FontSize="12"/>
                  </Button>
                  <Button Padding="10,6" ToolTip="Write a starter doc for this project"
                          Command="{Binding DataContext.CreateDocCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" Visibility="{Binding HasDoc, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                    <TextBlock Text="Create doc" FontSize="12"/>
                  </Button>
                  <Button Margin="7,0,0,0" Padding="10,6" ToolTip="{Binding SuggestionName, StringFormat=Attach {0} to this project}"
                          Command="{Binding DataContext.AcceptDocSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" Visibility="{Binding HasSuggestion, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding SuggestionName, StringFormat=Link {0}?}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                  </Button>
                  <Button Margin="7,0,0,0" Padding="10,6" ToolTip="Show this project in the inspector"
                          Command="{Binding DataContext.SelectDocEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="Inspect" FontSize="12"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Empty: vault connected, nothing matched the filter -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" IsHitTestVisible="False"
                Visibility="{Binding DocEntryCount, Converter={StaticResource CountVis}, ConverterParameter=Inverse}">
      <TextBlock Text="Nothing here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                 Visibility="{Binding HasVault, Converter={StaticResource BoolVis}}"/>
      <TextBlock Text="No project matches this filter." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"
                 Visibility="{Binding HasVault, Converter={StaticResource BoolVis}}"/>
    </StackPanel>
  </Grid>
</UserControl>
