<UserControl x:Class="Puppeteer.App.Controls.DocsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Puppeteer.App.Controls"
             xmlns:conv="clr-namespace:Puppeteer.App.Converters">
  <UserControl.Resources>
    <conv:DocStatusBrushConverter x:Key="DocStatusBrush"/>
    <conv:DocStatusIconConverter x:Key="DocStatusIcon"/>
    <!-- The window's BareList lives in Window.Resources, which a separately parsed UserControl
         cannot reach with StaticResource; the list needs its own. -->
    <Style x:Key="PlainList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <!-- ===== BROWSE ===== -->
    <Grid Margin="26,20,26,22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header. A flat WrapPanel rather than a left/right split: the summary text and the button
           row are both variable-width, so pinning buttons to a leftover Grid column let them get
           squeezed to icon-only slivers once the summary text grew. Wrapping whole buttons onto a
           new line keeps every one readable at any width. -->
      <WrapPanel Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center">
          <TextBlock Text="Docs" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="{Binding DocsSummary}" VerticalAlignment="Center" Margin="14,8,0,0" Style="{StaticResource MutedText}"/>
        </StackPanel>
        <Button Command="{Binding OpenIndexReaderCommand}" Margin="0,0,8,6" Padding="12,8" ToolTip="Read the index that maps the whole library">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDoc}" Width="13" Height="13"/>
            <TextBlock Text="Index" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding LinkAllDocsCommand}" Margin="0,0,8,6" Padding="12,8"
                ToolTip="Attach every project to the doc Puppeteer found for it, near-misses included">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlusCircle}" Width="13" Height="13"/>
            <TextBlock Text="Link all" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding ReloadDocsCommand}" Margin="0,0,8,6" Padding="12,8" ToolTip="Re-read every doc from disk">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" Width="13" Height="13"/>
            <TextBlock Text="Reload" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding SyncAllDocFactsCommand}" Margin="0,0,8,6" Padding="12,8"
                ToolTip="Rewrite every linked doc's Location, Stack and Last activity from the repo. Prose is left alone.">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBranch}" Width="13" Height="13"/>
            <TextBlock Text="Sync facts" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding OpenDocsFolderCommand}" Margin="0,0,0,6" Padding="12,8" ToolTip="Open the docs folder in Explorer">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolderOpen}" Width="13" Height="13"/>
            <TextBlock Text="Open folder" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>

      <!-- Filters -->
      <Grid Grid.Row="1" Margin="0,0,0,14" Visibility="{Binding HasVault, Converter={StaticResource BoolVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Column="0">
          <StackPanel Margin="0,0,9,10">
            <TextBlock Text="Status" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
            <ComboBox Width="160" ItemsSource="{Binding DocFilters}" SelectedItem="{Binding DocFilter}" ToolTip="Filter by state"/>
          </StackPanel>
          <StackPanel Margin="0,0,9,10" Visibility="{Binding HasIndex, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Section" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
            <ComboBox Width="160" ItemsSource="{Binding DocSections}" SelectedItem="{Binding DocSection}"
                      ToolTip="Filter by the index's own sections"/>
          </StackPanel>
        </WrapPanel>
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14,0,0,10" Background="{StaticResource ChipBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
          <StackPanel Orientation="Horizontal">
            <Button Command="{Binding SetDocViewCommand}" CommandParameter="Grid" Style="{StaticResource ViewToggleButton}" ToolTip="Grid view" Margin="0,0,2,0">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGrid}" Width="15" Height="15"
                    Stroke="{Binding DocView, Converter={StaticResource ViewStroke}, ConverterParameter=Grid}"/>
            </Button>
            <Button Command="{Binding SetDocViewCommand}" CommandParameter="List" Style="{StaticResource ViewToggleButton}" ToolTip="List view">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconList}" Width="15" Height="15"
                    Stroke="{Binding DocView, Converter={StaticResource ViewStroke}, ConverterParameter=List}"/>
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Empty: no vault connected -->
      <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                  Visibility="{Binding HasVault, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDoc}" Width="28" Height="28" Stroke="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="No docs folder connected" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                   Text="Add one or more folders where you keep markdown docs. Puppeteer reads what is already there, matches each doc to a project, and writes back only what you ask it to."/>
        <Button Command="{Binding AddDocsFolderCommand}" Style="{StaticResource AccentOutlineButton}" Margin="0,16,0,0" Padding="14,10" HorizontalAlignment="Center">
          <TextBlock Text="Add docs folder" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
        </Button>
      </StackPanel>

      <!-- Rows / cards. Both templates live in the style so the trigger can swap them; a locally
           set ItemTemplate would outrank it and pin the page to one view. -->
      <ListBox Grid.Row="2" ItemsSource="{Binding DocEntries}" SelectedItem="{Binding SelectedDocEntry, Mode=TwoWay}"
               MouseDoubleClick="Row_DoubleClick"
               ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               Visibility="{Binding HasVault, Converter={StaticResource BoolVis}}">
        <ListBox.Style>
          <Style TargetType="ListBox" BasedOn="{StaticResource PlainList}">
            <Setter Property="ItemTemplate">
              <Setter.Value>
                <DataTemplate>
                  <Border Padding="16,14" Margin="0,0,0,9" BorderThickness="1" CornerRadius="12" Cursor="Hand"
                          ToolTip="Click to inspect this project" MouseLeftButtonUp="Row_Click"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Hide / Show project" Command="{Binding PlacementTarget.Tag.ToggleHiddenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext.Project, RelativeSource={RelativeSource AncestorType=ContextMenu}}"><MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource IconEyeOff}" Width="14" Height="14"/></MenuItem.Icon></MenuItem>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MaxWidth="290"/>
                      </Grid.ColumnDefinitions>
                      <Path Width="14" Height="14" VerticalAlignment="Top" Margin="0,5,0,0" Stretch="Uniform" StrokeThickness="1.8"
                            Data="{Binding Status, Converter={StaticResource DocStatusIcon}}"
                            Stroke="{Binding Status, Converter={StaticResource DocStatusBrush}}" ToolTip="{Binding Status}"/>
                      <StackPanel Grid.Column="1" Margin="14,0,14,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center"/>
                          <Border Margin="10,0,0,0" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                                  BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource DocStatusBrush}}"/>
                          </Border>
                          <Border Margin="6,0,0,0" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                                  BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center"
                                  Visibility="{Binding HasIndexNote, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding IndexNote}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                          </Border>
                          <Border Margin="6,0,0,0" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                                  BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center"
                                  Visibility="{Binding HasReadme, Converter={StaticResource BoolVis}}" ToolTip="{Binding ReadmePath}">
                            <TextBlock Text="README" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                          </Border>
                          <TextBlock Text="{Binding LinkNote}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                     Foreground="{StaticResource FaintBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasNextStep, Converter={StaticResource BoolVis}}">
                          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="11" Height="11"
                                Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding NextStep}" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Activity}" HorizontalAlignment="Right" TextAlignment="Right" Style="{StaticResource MutedText}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="290" ToolTip="{Binding Activity}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                          <Button Padding="10,6" ToolTip="Read this project's doc and README"
                                  Command="{Binding DataContext.OpenReaderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="Read" FontSize="12"/>
                          </Button>
                          <Button Margin="6,0,0,0" Padding="10,6" ToolTip="Write a starter doc for this project"
                                  Command="{Binding DataContext.CreateDocCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" Visibility="{Binding HasDoc, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                            <TextBlock Text="Create doc" FontSize="12"/>
                          </Button>
                          <Button Margin="6,0,0,0" Padding="10,6" ToolTip="{Binding SuggestionName, StringFormat=Attach {0} to this project}"
                                  Command="{Binding DataContext.AcceptDocSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" Visibility="{Binding HasSuggestion, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding SuggestionName, StringFormat=Link {0}?}" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                          </Button>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <DataTrigger Binding="{Binding DocView}" Value="Grid">
                <Setter Property="ItemsPanel">
                  <Setter.Value>
                    <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="300" ItemHeight="224"/></ItemsPanelTemplate>
                  </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate">
                  <Setter.Value>
                    <DataTemplate>
                      <controls:DocCard/>
                    </DataTemplate>
                  </Setter.Value>
                </Setter>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ListBox.Style>
      </ListBox>

      <!-- Empty: vault connected, nothing matched the filter -->
      <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" IsHitTestVisible="False"
                  Visibility="{Binding DocEntryCount, Converter={StaticResource CountVis}, ConverterParameter=Inverse}">
        <TextBlock Text="Nothing here" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Visibility="{Binding HasVault, Converter={StaticResource BoolVis}}"/>
        <TextBlock Text="No project matches this filter." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"
                   Visibility="{Binding HasVault, Converter={StaticResource BoolVis}}"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
