<UserControl x:Class="Puppeteer.App.Controls.DocsSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Project docs" Style="{StaticResource SectionTitle}" Margin="0,26,0,6"/>
    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="Two files' worth of setup: the folder holding one markdown doc per project, and the single index that maps the library. Puppeteer reads what is already there and matches each doc to a project. Editing outside Puppeteer is expected — it reloads when a file changes and refuses to save over an edit it has not seen."/>

    <Border Style="{StaticResource SettingRow}">
      <StackPanel>
        <TextBlock Text="States folder" Style="{StaticResource SettingLabel}"/>
        <TextBlock Text="One doc per project, in category subfolders — for example D:\Programming\Resources\Projects. Leave blank to turn the Docs page off." Style="{StaticResource SettingHint}"/>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding DocsFolder, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"/>
          <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,9" Content="Browse" Command="{Binding ChooseDocsFolderCommand}"/>
          <Button Grid.Column="2" Margin="6,0,0,0" Padding="12,9" Content="Clear" Command="{Binding ClearDocsFolderCommand}"/>
        </Grid>
        <TextBlock Text="{Binding DocsSummary}" Style="{StaticResource SettingHint}" Margin="2,10,0,0"/>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingRow}">
      <StackPanel>
        <TextBlock Text="Projects index" Style="{StaticResource SettingLabel}"/>
        <TextBlock Text="The one markdown file that lists every project and links to its doc. Puppeteer reads the archived and paused markers from it, and uses its links to find docs whose folder has since been renamed. Leave blank to use a projects.md sitting in the states folder. Never written to." Style="{StaticResource SettingHint}"/>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding IndexFile, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"/>
          <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,9" Content="Browse" Command="{Binding ChooseIndexFileCommand}"/>
          <Button Grid.Column="2" Margin="6,0,0,0" Padding="12,9" Content="Clear" Command="{Binding ClearIndexFileCommand}"/>
        </Grid>
        <Grid Margin="2,10,0,0">
          <TextBlock Text="{Binding IndexSummary}" Style="{StaticResource SettingHint}"/>
          <TextBlock HorizontalAlignment="Right" Text="{Binding ResolvedIndexFile}" Style="{StaticResource SettingHint}"
                     FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource SettingRow}">
      <Grid>
        <StackPanel Margin="0,0,20,0">
          <TextBlock Text="Keep a state history" Style="{StaticResource SettingLabel}"/>
          <TextBlock Text="Records each project's branch, head commit and uncommitted count after every git refresh, so you can see when a project last moved. A row is only kept when something actually changed." Style="{StaticResource SettingHint}"/>
        </StackPanel>
        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding DocsAutoSnapshot}"/>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
