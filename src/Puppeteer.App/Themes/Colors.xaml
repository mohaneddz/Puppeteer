<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Surfaces -->
  <Color x:Key="WindowColor">#0B0D10</Color>
  <Color x:Key="SidebarColor">#0E1013</Color>
  <Color x:Key="PanelColor">#0D0F12</Color>
  <Color x:Key="CardColor">#14171B</Color>
  <Color x:Key="CardHoverColor">#171B20</Color>
  <Color x:Key="ElevatedColor">#1A1E24</Color>
  <Color x:Key="ChipColor">#181B20</Color>

  <!-- Lines -->
  <Color x:Key="BorderColor">#23272E</Color>
  <Color x:Key="BorderSoftColor">#1C2026</Color>
  <Color x:Key="BorderStrongColor">#2E333B</Color>

  <!-- Text -->
  <Color x:Key="TextColor">#ECE7DA</Color>
  <Color x:Key="TextDimColor">#B7BCC4</Color>
  <Color x:Key="MutedColor">#767C86</Color>
  <Color x:Key="FaintColor">#565C66</Color>

  <!-- Accents -->
  <Color x:Key="AmberColor">#E2A038</Color>
  <Color x:Key="AmberBrightColor">#F0B24A</Color>
  <Color x:Key="AmberDeepColor">#C9871F</Color>
  <Color x:Key="GreenColor">#5BC873</Color>
  <Color x:Key="BlueColor">#5B9BD5</Color>
  <Color x:Key="RedColor">#E5715B</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}"/>
  <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource ChipColor}"/>

  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AmberColor}"/>
  <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AmberBrightColor}"/>
  <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AmberDeepColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#26200F"/>
  <SolidColorBrush x:Key="AccentGlowBrush" Color="#332913"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource GreenColor}"/>
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource BlueColor}"/>
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource RedColor}"/>

  <!-- Terminal palette -->
  <SolidColorBrush x:Key="TerminalBgBrush" Color="#080A0C"/>
  <SolidColorBrush x:Key="TerminalGreenBrush" Color="#7FD98C"/>
  <SolidColorBrush x:Key="TerminalCyanBrush" Color="#5BC0C7"/>
</ResourceDictionary>
