<Window x:Class="Puppeteer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Puppeteer.App.Controls"
        xmlns:vm="clr-namespace:Puppeteer.App.ViewModels"
        xmlns:conv="clr-namespace:Puppeteer.App.Converters"
        Title="Puppeteer" Width="1600" Height="900" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/icon.png" WindowStyle="None" ResizeMode="CanResize" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <conv:EqualsMultiConverter x:Key="EqualsMulti"/>
    <Style x:Key="BareList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="5"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
    </Style>

    <!-- Row splitter (terminal resize handle): a thin line that only reads as a bar on hover, not a
         permanent slab of color sitting on top of the terminal panel. -->
    <Style x:Key="RowSplitter" TargetType="GridSplitter">
      <Setter Property="Height" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="SizeNS"/>
      <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Grid Background="Transparent">
              <Border x:Name="Line" Height="1" VerticalAlignment="Center" Background="{StaticResource BorderStrongBrush}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Line" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Line" Property="Height" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One terminal pane: prompt + output + input. Data context is a TerminalSessionViewModel. -->
    <DataTemplate x:Key="TerminalPane" DataType="{x:Type vm:TerminalSessionViewModel}">
      <Border CornerRadius="5" Margin="2" Background="{StaticResource TerminalBgBrush}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PreviewMouseLeftButtonDown="TerminalPane_PreviewMouseLeftButtonDown">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Only shown when panes are split: with a single pane the tab bar above already names the
               session and carries the same stop / restart / close actions. -->
          <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="7,3"
                  Tag="PaneDrag" Cursor="SizeAll" ToolTip="Drag to reorder · double-click to maximize"
                  Visibility="{Binding DataContext.TerminalSplit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Text="exited" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                           Visibility="{Binding Running, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
              </StackPanel>
            </Grid>
          </Border>
          <!-- The session banner sits outside the scrolled region so the output below it can be a
               plain virtualizing list. Wrapping the output in a StackPanel (as it was) hands the
               panel infinite height, which silently defeats virtualization and realizes a TextBlock
               for every one of the 2000 buffered lines. -->
          <Grid Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="9,6,9,1" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TerminalGreenBrush}" FontWeight="Bold"/><Run Text=":" Foreground="{StaticResource MutedTextBrush}"/><Run Text="{Binding ProjectPath, Mode=OneWay}" Foreground="{StaticResource TerminalCyanBrush}"/>
            </TextBlock>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Output}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                  <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="9,0,9,5"
                                ScrollChanged="TerminalOutput_ScrollChanged">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </ControlTemplate>
              </ItemsControl.Template>
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap"
                             Foreground="{Binding Converter={StaticResource TerminalLine}}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="9,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="›" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Grid.Column="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Running}"
                       Background="Transparent" BorderThickness="0" Padding="0" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                       VerticalContentAlignment="Center" KeyDown="TerminalInput_KeyDown"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource IconButton}" Width="20" Height="20" ToolTip="Stop process" Command="{Binding StopCommand}"
                        Visibility="{Binding Running, Converter={StaticResource BoolVis}}">
                  <Path Data="{StaticResource IconStop}" Width="10" Height="10" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="20" Height="20" ToolTip="Restart"
                        Command="{Binding DataContext.RestartSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" Width="11" Height="11"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="20" Height="20" ToolTip="Close"
                        Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                  <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- ============ FULL-WIDTH TITLE BAR ============ -->
      <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="14,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- Logo -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
            <Image Source="Assets/icon.png" Width="30" Height="30"/>
            <TextBlock Text="Puppeteer" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <!-- Sidebar toggle -->
          <Button Grid.Column="1" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconButton}" Width="36" Height="36" Margin="8,0,0,0" ToolTip="Toggle sidebar"
                  Command="{Binding ToggleSidebarCommand}">
            <Path Style="{StaticResource IconPath}" Width="15" Height="15"
                  Data="{Binding SidebarCollapsed, Converter={StaticResource PanelToggleIcon}, ConverterParameter=Left}"/>
          </Button>
          <!-- Search -->
          <!-- Stretch with a cap rather than a fixed Width, so a narrow window shrinks the search box
               instead of crushing the toolbar buttons on its right. -->
          <Border Grid.Column="2" WindowChrome.IsHitTestVisibleInChrome="True" MaxWidth="480" HorizontalAlignment="Stretch" Height="38" Margin="16,0,16,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
            <Grid Margin="12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Path Grid.Column="0" Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}" Width="15" Height="15" Stroke="{StaticResource MutedTextBrush}"/>
              <Grid Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="{Binding SearchPlaceholder}" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" FontSize="13"
                           Visibility="{Binding ActiveSearch, Converter={StaticResource EmptyVis}, ConverterParameter=Inverse}" IsHitTestVisible="False"/>
                <TextBox x:Name="SearchBox" Text="{Binding ActiveSearch, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center"/>
              </Grid>
              <Border Grid.Column="2" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="Ctrl K" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
              </Border>
            </Grid>
          </Border>
          <!-- Actions + window caption -->
          <StackPanel Grid.Column="3" WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding AddRootCommand}" Height="38" Padding="15,0">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}"/>
                <TextBlock Text="Add Root" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="38" Height="38" Margin="9,0,0,0" ToolTip="Rescan all roots"
                    Command="{Binding RescanCommand}">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="38" Height="38" Margin="4,0,0,0" ToolTip="Toggle details panel"
                    Command="{Binding ToggleDetailsCommand}">
              <Path Style="{StaticResource IconPath}" Width="15" Height="15"
                    Data="{Binding DetailsCollapsed, Converter={StaticResource PanelToggleIcon}, ConverterParameter=Right}"/>
            </Button>
            <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="10,0,4,0"/>
            <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize">
              <Rectangle Width="11" Height="1.4" Fill="{StaticResource MutedTextBrush}"/>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize">
              <Path x:Name="MaximizeIcon" Data="{StaticResource IconWindowMaximize}" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
            <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close">
              <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ CONTENT (below the title bar) ============ -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="230" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="380"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition x:Name="DetailsColumn" Width="346" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Nav -->
            <StackPanel Grid.Row="0" Margin="13,16,13,0">
              <controls:SidebarItem Icon="{StaticResource IconFolder}" Label="Projects"
                                    IsActive="{Binding CurrentPage, Converter={StaticResource PageActive}, ConverterParameter=Projects}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Projects"/>
              <controls:SidebarItem Icon="{StaticResource IconDoc}" Label="Docs"
                                    IsActive="{Binding CurrentPage, Converter={StaticResource PageActive}, ConverterParameter=Docs}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Docs"/>
              <controls:SidebarItem Icon="{StaticResource IconActivity}" Label="Running" ShowDot="True" Badge="{Binding RunningBadge}"
                                    IsActive="{Binding CurrentPage, Converter={StaticResource PageActive}, ConverterParameter=Running}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Running"/>
              <controls:SidebarItem Icon="{StaticResource IconSettings}" Label="Settings"
                                    IsActive="{Binding CurrentPage, Converter={StaticResource PageActive}, ConverterParameter=Settings}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
            </StackPanel>
            <!-- Folder tree -->
            <Grid Grid.Row="1" Margin="13,18,8,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Margin="5,0,5,6">
                <StackPanel Orientation="Horizontal">
                  <Button Command="{Binding SetFolderPaneCommand}" CommandParameter="Projects" Style="{StaticResource CardLinkButton}" Padding="2,1" Margin="0,0,12,0" ToolTip="Show project folders">
                    <TextBlock Text="PROJECTS" FontSize="10.5" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProjectsPane}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>
                  <Button Command="{Binding SetFolderPaneCommand}" CommandParameter="Documentation" Style="{StaticResource CardLinkButton}" Padding="2,1" ToolTip="Show documentation folders">
                    <TextBlock Text="DOCS" FontSize="10.5" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDocsPane}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>
                </StackPanel>
                <!-- Projects-pane actions -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding IsProjectsPane, Converter={StaticResource BoolVis}}">
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="0,0,4,0"
                          ToolTip="Add root folder" AutomationProperties.Name="Add root folder" Command="{Binding AddRootCommand}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="13" Height="13"/>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                          ToolTip="{Binding FolderExpandToggleToolTip}" Command="{Binding ToggleFolderExpansionCommand}">
                    <Path Width="13" Height="13" Stroke="{StaticResource MutedTextBrush}">
                      <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                          <Setter Property="Data" Value="{StaticResource IconChevronUp}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding AreAllFoldersCollapsed}" Value="True">
                              <Setter Property="Data" Value="{StaticResource IconChevronDown}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Path.Style>
                    </Path>
                  </Button>
                  <Button Style="{StaticResource CardLinkButton}" Content="Clear" FontSize="11"
                          Command="{Binding ClearFolderCommand}"
                          Visibility="{Binding FolderFilterActive, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <!-- Docs-pane actions -->
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding IsDocsPane, Converter={StaticResource BoolVis}}">
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="0,0,4,0"
                          ToolTip="Add docs folder" AutomationProperties.Name="Add docs folder" Command="{Binding AddDocsFolderCommand}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="13" Height="13"/>
                  </Button>
                  <Button Style="{StaticResource CardLinkButton}" Content="Clear" FontSize="11"
                          Command="{Binding ClearDocsFolderFilterCommand}"
                          Visibility="{Binding DocsFolderFilterActive, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </Grid>

              <!-- Project folders -->
              <TreeView Grid.Row="1" ItemsSource="{Binding FolderTree}" Background="Transparent" BorderThickness="0"
                        Visibility="{Binding IsProjectsPane, Converter={StaticResource BoolVis}}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                  <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                  </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Button HorizontalContentAlignment="Left" Padding="3,3"
                            Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                            CommandParameter="{Binding}" ToolTip="{Binding RightClickToolTip}"
                            PreviewMouseRightButtonUp="FolderHide_RightClick">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CardLinkButton}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                              <Setter Property="Opacity" Value="0.38"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <Button.Background>
                        <MultiBinding Converter="{StaticResource ActiveFolder}">
                          <Binding Path="Path"/>
                          <Binding Path="DataContext.SelectedFolder" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                        </MultiBinding>
                      </Button.Background>
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolder}" Width="13" Height="13" Stroke="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProjectCount}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource FaintBrush}"/>
                      </StackPanel>
                    </Button>
                  </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>

              <!-- Documentation folders -->
              <Grid Grid.Row="1" Visibility="{Binding IsDocsPane, Converter={StaticResource BoolVis}}">
                <TreeView ItemsSource="{Binding DocsFolderTree}" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Visibility="{Binding HasDocsFolders, Converter={StaticResource BoolVis}}">
                  <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                      <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                    </Style>
                  </TreeView.ItemContainerStyle>
                  <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                      <Button HorizontalContentAlignment="Left" Padding="3,3" ToolTip="{Binding Path}"
                              Command="{Binding DataContext.SelectDocsFolderCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                              CommandParameter="{Binding}" Style="{StaticResource CardLinkButton}">
                        <Button.Background>
                          <MultiBinding Converter="{StaticResource ActiveFolder}">
                            <Binding Path="Path"/>
                            <Binding Path="DataContext.SelectedDocsFolder" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                          </MultiBinding>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                          <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDoc}" Width="13" Height="13" Stroke="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding ProjectCount}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource FaintBrush}"/>
                        </StackPanel>
                      </Button>
                    </HierarchicalDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock Text="No docs folders yet. Use + to add one." Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap"
                           Margin="5,4,5,0" VerticalAlignment="Top"
                           Visibility="{Binding HasDocsFolders, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
              </Grid>
            </Grid>
            <!-- Bottom running pill -->
            <Button Grid.Row="2" Margin="16,10,16,16" Padding="12,9" HorizontalContentAlignment="Stretch"
                    Visibility="{Binding RunningBadge, Converter={StaticResource EmptyVis}}"
                    Command="{Binding NavigateCommand}" CommandParameter="Running" ToolTip="View running terminal sessions">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Running" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock Text="{Binding RunningCount}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="13" Height="13" Margin="8,0,0,0" Stroke="{StaticResource FaintBrush}"/>
                </StackPanel>
              </Grid>
            </Button>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>

        <!-- ===== MAIN COLUMN ===== -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="PagesRow" Height="*"/>
            <RowDefinition x:Name="TerminalSplitterRow" Height="0"/>
            <RowDefinition x:Name="TerminalRow" Height="0"/>
          </Grid.RowDefinitions>

          <!-- ===== PAGES ===== -->
          <Grid Grid.Row="0">
            <!-- Projects page. Right margin is 0 so the list (and its scrollbar) can bleed to the
                 content edge; the header/filter rows carry their own right inset instead. -->
            <Grid Margin="26,20,0,0" Visibility="{Binding IsLibraryPage, Converter={StaticResource BoolVis}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="0,0,26,0">
                <TextBlock Text="{Binding ProjectPageTitle}" Style="{StaticResource PageTitle}"/>
                <TextBlock VerticalAlignment="Center" Margin="14,8,0,0" Style="{StaticResource MutedText}">
                  <Run Text="{Binding Projects.Count, Mode=OneWay}"/><Run Text=" shown"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Scanning…" Foreground="{StaticResource AccentBrush}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,3" Margin="14,6,0,0" VerticalAlignment="Center"
                        Visibility="{Binding FolderFilterActive, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedFolder.Name}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Width="16" Height="16" Margin="7,0,0,0" Command="{Binding ClearFolderCommand}" ToolTip="Clear folder filter">
                      <Path Data="{StaticResource IconClose}" Width="8" Height="8" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
              <!-- Filter dropdowns + view toggle -->
              <Grid Grid.Row="1" Margin="0,18,26,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Type" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Width="150" Height="36"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Technology" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding TechnologyOptions}" SelectedItem="{Binding SelectedTechnology}" Width="150" Height="36"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Category" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Width="150" Height="36"/>
                  </StackPanel>
                  <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="Status" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatus}" Width="130" Height="36">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <Path Data="{Binding Converter={StaticResource LifecycleStatusIcon}}" Stroke="{Binding Converter={StaticResource LifecycleStatusBrush}}"
                                  StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Margin="14,0,0,0">
                    <TextBlock Text="Show" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SpecialFilters}" SelectedItem="{Binding SelectedSpecial}" Width="150" Height="36"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Sort" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" Width="130" Height="36"/>
                  </StackPanel>
                  <Border VerticalAlignment="Bottom" Height="36" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                      <Button Command="{Binding SetViewCommand}" CommandParameter="Grid" Style="{StaticResource ViewToggleButton}" ToolTip="Grid view" Margin="0,0,2,0">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGrid}" Width="15" Height="15" Stroke="{Binding ViewMode, Converter={StaticResource ViewStroke}, ConverterParameter=Grid}"/>
                      </Button>
                      <Button Command="{Binding SetViewCommand}" CommandParameter="List" Style="{StaticResource ViewToggleButton}" ToolTip="List view">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconList}" Width="15" Height="15" Stroke="{Binding ViewMode, Converter={StaticResource ViewStroke}, ConverterParameter=List}"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
              <ListBox Grid.Row="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="0,0,12,16"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                       VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Style>
                  <Style TargetType="ListBox" BasedOn="{StaticResource BareList}">
                    <Setter Property="ItemsPanel">
                      <Setter.Value>
                        <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" ItemHeight="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=Window}}"/></ItemsPanelTemplate>
                      </Setter.Value>
                    </Setter>
                    <!-- Both templates live in the style: a locally-set ItemTemplate on the ListBox
                         would outrank the trigger below and pin the view to cards in both modes. -->
                    <Setter Property="ItemTemplate">
                      <Setter.Value>
                        <DataTemplate><controls:ProjectCard/></DataTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewMode}" Value="List">
                        <Setter Property="ItemsPanel">
                          <Setter.Value>
                            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                          </Setter.Value>
                        </Setter>
                        <Setter Property="ItemTemplate">
                          <Setter.Value>
                            <DataTemplate><controls:ProjectRow/></DataTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.Style>
              </ListBox>
              <!-- Empty: no roots yet -->
              <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                          Visibility="{Binding Projects.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}">
                <StackPanel Visibility="{Binding HasAnyProjects, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolder}" Width="30" Height="30" Stroke="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="No projects yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                  <TextBlock Text="Add a root folder to scan for projects. Puppeteer detects .NET, Tauri, Flutter, Next.js, Rust, and more."
                             Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                  <Button Command="{Binding AddRootCommand}" HorizontalAlignment="Center" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}"/>
                      <TextBlock Text="Add Root" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
                <!-- Empty: filtered to nothing -->
                <StackPanel Visibility="{Binding HasAnyProjects, Converter={StaticResource BoolVis}}">
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}" Width="28" Height="28" Stroke="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="No matches" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                  <TextBlock Text="No projects match the current filters or search." Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                  <Button Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" Padding="16,10" Content="Clear filters"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- Running page -->
            <Grid Margin="26,20,26,22" Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Running}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Running" Style="{StaticResource PageTitle}"/>
                  <TextBlock VerticalAlignment="Center" Margin="14,8,0,0" Style="{StaticResource MutedText}">
                    <Run Text="{Binding RunningCount, Mode=OneWay}"/><Run Text=" active"/>
                  </TextBlock>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding StopAllCommand}" Padding="13,8">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconStop}" Width="12" Height="12" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" Stretch="Uniform"/>
                    <TextBlock Text="Stop all" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
              <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                          Visibility="{Binding Sessions.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconActivity}" Width="28" Height="28" Stroke="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Nothing running" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Open a terminal on a project and it will show up here." Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
              </StackPanel>
              <ListBox Grid.Row="1" Style="{StaticResource BareList}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="16" Margin="0,0,0,10" Cursor="Hand">
                      <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PanelCard}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                              <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Accent}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                          <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" FontSize="14.5"/>
                          <TextBlock Text="{Binding Command}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Duration}" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                          <Border Margin="12,0,0,0" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                            <TextBlock FontSize="11" Text="running" Foreground="{StaticResource SuccessBrush}"
                                       Visibility="{Binding Running, Converter={StaticResource BoolVis}}"/>
                          </Border>
                          <Border Margin="12,0,0,0" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3"
                                  Visibility="{Binding Running, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}">
                            <TextBlock FontSize="11" Text="exited" Foreground="{StaticResource MutedTextBrush}"/>
                          </Border>
                          <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="8,0,0,0" ToolTip="Stop process"
                                  Command="{Binding StopCommand}" Visibility="{Binding Running, Converter={StaticResource BoolVis}}">
                            <Path Data="{StaticResource IconStop}" Width="11" Height="11" Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" Stretch="Uniform"/>
                          </Button>
                          <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="2,0,0,0" ToolTip="Close session"
                                  Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <!-- Docs page -->
            <controls:DocsPage Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Docs}"/>

            <!-- Settings page -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Settings}">
              <StackPanel Margin="26,20,26,22">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
                <TextBlock Text="Roots, startup behaviour, terminals and appearance." Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,22"
                           Text="Ctrl+T: new terminal · Ctrl+W: close terminal · Ctrl+Shift+T: reopen closed terminal&#10;Ctrl+Tab / Ctrl+Shift+Tab: next / previous terminal · Ctrl+1–8: select tab · Ctrl+9: last tab&#10;Ctrl+F / Ctrl+K: search projects · Ctrl+R: rescan · Ctrl+`: show/hide terminals&#10;Ctrl+Alt+P: show/hide Puppeteer — works anywhere, even while it's hidden in the tray&#10;Reopen retains output and input history in this app session; programs and shell variables start fresh."/>

                <!-- Two columns once there is room, one when the window is narrow -->
                <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource ColumnCount}, ConverterParameter=820}">
                  <StackPanel Margin="0,0,13,0">

                <TextBlock Text="Roots" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Roots}" Margin="0,0,0,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource PanelCard}" Padding="14" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolder}" Width="16" Height="16" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Path}" VerticalAlignment="Center" Margin="12,0,12,0" FontWeight="Medium" ToolTip="{Binding Path}"/>
                          </StackPanel>
                          <Button Grid.Column="1" HorizontalAlignment="Right" Content="Remove" ToolTip="Remove this root from the project library"
                                  Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No roots yet — use Add Root to scan a folder." Style="{StaticResource MutedText}" Margin="2,0,0,0"
                           Visibility="{Binding Roots.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}"/>

                <TextBlock Text="Startup &amp; notification area" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Text="Launch when Windows starts" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="Adds Puppeteer to your account's startup programs. No admin rights needed, and you can undo it from Task Manager." Style="{StaticResource SettingHint}"/>
                    </StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding LaunchAtStartup}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Text="Start hidden in the tray" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="On a startup launch, go straight to the notification area instead of opening the window." Style="{StaticResource SettingHint}"/>
                    </StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StartMinimized}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Text="Minimize to the taskbar" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="Minimizing keeps Puppeteer on the taskbar. Use the system tray icon to hide or show the window." Style="{StaticResource SettingHint}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Text="Close to the tray" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="The close button hides Puppeteer instead of quitting it. Quit from the tray icon's menu." Style="{StaticResource SettingHint}"/>
                    </StackPanel>
                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding CloseToTray}"/>
                  </Grid>
                </Border>

                <TextBlock Text="Terminal" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                      <TextBlock Text="Default shell" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="Used for new sessions and command presets." Style="{StaticResource SettingHint}"/>
                    </StackPanel>
                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="180"
                              ItemsSource="{Binding Shells}" SelectedItem="{Binding DefaultShell}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                      <TextBlock Text="Scrollback" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="Lines of output kept per session. Higher costs memory when a watch task is chatty." Style="{StaticResource SettingHint}"/>
                    </StackPanel>
                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="120"
                              ItemsSource="{Binding ScrollbackOptions}" SelectedItem="{Binding Scrollback}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Text="Terminals close when you quit" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="Quitting stops every terminal automatically. Hiding to the tray keeps them running." Style="{StaticResource SettingHint}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                      <TextBlock Text="Density" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="Compact fits more project cards on screen at once." Style="{StaticResource SettingHint}"/>
                    </StackPanel>
                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="160"
                              ItemsSource="{Binding Densities}" SelectedItem="{Binding Density}"/>
                  </Grid>
                </Border>

                <TextBlock Text="Tools" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <Border Style="{StaticResource SettingRow}">
                  <StackPanel>
                    <TextBlock Text="Open in IDE command" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="The editor to launch with the project folder — code, rider, subl. Leave blank to open the repository in VS Code."
                               Style="{StaticResource SettingHint}"/>
                    <TextBox Text="{Binding IdeCommand, UpdateSourceTrigger=LostFocus}" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}"/>
                  </StackPanel>
                </Border>

                <TextBlock Text="Backup &amp; restore" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Text="Library backup" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="Save all roots, project details, custom names and icons, categories, links, history and settings in one portable backup. Project files are not copied." Style="{StaticResource SettingHint}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Create backup…" Command="{Binding CreateBackupCommand}"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource SettingRow}">
                  <Grid>
                    <StackPanel Margin="0,0,20,0">
                      <TextBlock Text="Restore a backup" Style="{StaticResource SettingLabel}"/>
                      <TextBlock Text="Replaces this device's saved Puppeteer library data. Your project folders and files stay exactly as they are." Style="{StaticResource SettingHint}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="Restore backup…" Command="{Binding RestoreBackupCommand}"/>
                  </Grid>
                </Border>

                  </StackPanel>
                  <StackPanel Margin="13,0,0,0">

                <TextBlock Text="AI categorization (Groq)" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <TextBlock Text="Used to label projects as Personal / Client / Hackathon / Course from their README and path. Leave blank to use the .env key in development."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <!-- Masked by default: this sits on a page the user may well have open while sharing
                     their screen, and a Groq key is a credential like any other. -->
                <Grid Width="440" HorizontalAlignment="Left">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <PasswordBox x:Name="GroqKeyBox" PasswordChanged="GroqKey_Changed" FontFamily="{StaticResource MonoFont}"
                               Visibility="{Binding ShowGroqApiKey, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
                  <TextBox Text="{Binding GroqApiKey, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource MonoFont}"
                           Visibility="{Binding ShowGroqApiKey, Converter={StaticResource BoolVis}}"/>
                  <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,9" Command="{Binding ToggleGroqKeyVisibilityCommand}">
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Show"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowGroqApiKey}" Value="True">
                              <Setter Property="Text" Value="Hide"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Button>
                </Grid>
                <TextBlock Text="Using the key from .env" Style="{StaticResource MutedText}" FontSize="11.5" Foreground="{StaticResource SuccessBrush}" Margin="2,6,0,0"
                           Visibility="{Binding UsingEnvGroqKey, Converter={StaticResource BoolVis}}"/>
                <CheckBox Content="Automatically categorize new projects" IsChecked="{Binding AutoClassify}" Margin="0,14,0,0"/>

                <controls:DocsSettings/>

                <TextBlock Text="Detection" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <TextBlock Text="Tauri · .NET/WPF · Flutter · Next.js · Vite · Node.js · Qt · Android · Rust · Python · Godot"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>

                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <Grid HorizontalAlignment="Left">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + K" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="Focus search" Style="{StaticResource MutedText}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + N" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="New terminal" Style="{StaticResource MutedText}"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + `" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="Toggle terminal" Style="{StaticResource MutedText}"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + R" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="Rescan roots" Style="{StaticResource MutedText}"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + L" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="Clear terminal output" Style="{StaticResource MutedText}"/>
                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Esc" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="Clear search / close terminal" Style="{StaticResource MutedText}"/>
                </Grid>
                <TextBlock Text="Data" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Reset window layout" Command="{Binding ResetLayoutCommand}" Padding="14,9"/>
                  <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="9,0,0,0" Padding="14,9"
                          ToolTip="Where roots, projects, icons and preferences are stored"/>
                </StackPanel>

                <TextBlock Text="About" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                  <Run Text="Puppeteer"/> <Run Text="{Binding Version, Mode=OneWay}"/> <LineBreak/>
                  <Run Text="A focused Windows project hub — WPF and .NET 10."/>
                </TextBlock>

                  </StackPanel>
                </UniformGrid>
              </StackPanel>
            </ScrollViewer>

            <!-- Status toast -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Panel.ZIndex="10" Margin="0,0,0,26"
                    Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="15,10"
                    Visibility="{Binding StatusVisible, Converter={StaticResource BoolVis}}">
              <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.55" Color="#000000"/></Border.Effect>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Status}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ===== TERMINAL RESIZE HANDLE ===== -->
          <GridSplitter Grid.Row="1" Style="{StaticResource RowSplitter}" ResizeDirection="Rows"
                        DragCompleted="TerminalSplitter_DragCompleted"/>

          <!-- ===== TERMINAL ===== -->
          <Border Grid.Row="2" Background="{StaticResource TerminalBgBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
              </Grid.RowDefinitions>
              <!-- Header -->
              <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,0,10,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.ColumnSpan="2" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Terminal" Margin="6,0,10,0" VerticalAlignment="Center" FontWeight="Medium" FontSize="12.5"/>
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center" CanContentScroll="False">
                    <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" VerticalAlignment="Center" Background="Transparent"
                             AllowDrop="True" PreviewMouseLeftButtonDown="TerminalTab_PreviewMouseLeftButtonDown" PreviewMouseMove="TerminalTab_PreviewMouseMove"
                             DragOver="TerminalTab_DragOver" Drop="TerminalTab_Drop"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Margin" Value="3,0"/>
                          <Setter Property="Cursor" Value="Hand"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="10,5">
                                  <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1" CornerRadius="{Binding Project, Converter={StaticResource ProjectIconShape}}" VerticalAlignment="Center"
                                            ToolTip="{Binding ProjectTechnology}">
                                      <Rectangle RadiusX="{Binding Project, Converter={StaticResource ProjectIconRadius}}" RadiusY="{Binding Project, Converter={StaticResource ProjectIconRadius}}">
                                        <Rectangle.Fill>
                                          <ImageBrush ImageSource="{Binding Project, Converter={StaticResource ProjectIcon}}" Stretch="Uniform"/>
                                        </Rectangle.Fill>
                                      </Rectangle>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextDimBrush}"/>
                                    <Button Style="{StaticResource IconButton}" Width="18" Height="18" Margin="7,0,-2,0" ToolTip="Close tab"
                                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                      <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
                                    </Button>
                                  </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                  </Trigger>
                                  <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                    <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                    </ListBox>
                    </ScrollViewer>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="3,0,0,0" VerticalAlignment="Center" ToolTip="New tab"
                            Command="{Binding NewSessionCommand}">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="13" Height="13"/>
                    </Button>
                  </Grid>
                </Grid>
              </Border>
              <!-- Body: single pane or split grid -->
              <Grid Grid.Row="1">
                <TextBlock Text="No terminal open. Select a project and press Open Terminal." Style="{StaticResource MutedText}" Margin="16,12,0,0"
                           Visibility="{Binding SelectedSession, Converter={StaticResource NullVis}, ConverterParameter=Inverse}"/>
                <ContentControl Content="{Binding SelectedSession}" ContentTemplate="{StaticResource TerminalPane}"
                                Visibility="{Binding TerminalSplit, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
                <ScrollViewer
                              Visibility="{Binding TerminalSplit, Converter={StaticResource BoolVis}}">
                  <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                      <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding TerminalScrollable}" Value="True">
                          <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TerminalHorizontalScrollable}" Value="True">
                          <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ScrollViewer.Style>
                  <controls:TerminalSplitGrid Sessions="{Binding Sessions}" Columns="{Binding SplitColumns}" Scrollable="{Binding TerminalScrollable}" HorizontalScrollable="{Binding TerminalHorizontalScrollable}"
                                              ViewportWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                              ViewportHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </ScrollViewer>
              </Grid>
              <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="8,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <ComboBox ItemsSource="{Binding Shells}" SelectedItem="{Binding DefaultShell}" Width="165" Height="36" FontSize="12" ToolTip="Shell used for new terminals"/>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="5,0,0,0" ToolTip="New shell" Command="{Binding NewSessionCommand}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTerminal}" Width="12" Height="12"/>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Split panes" Command="{Binding ToggleSplitCommand}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSplit}" Width="12" Height="12" Stroke="{Binding TerminalSplit, Converter={StaticResource ViewStroke}, ConverterParameter=True}"/>
                  </Button>
                  <StackPanel Orientation="Horizontal" Visibility="{Binding TerminalSplit, Converter={StaticResource BoolVis}}">
                  <Button Width="24" Height="24" Command="{Binding ToggleTerminalScrollableCommand}" AutomationProperties.Name="Vertical terminal scrolling">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="ToolTip" Value="Vertical scrolling: off — enable to resize rows independently"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TerminalScrollable}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="ToolTip" Value="Vertical scrolling: on — disable to fit rows to screen height"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Path Style="{StaticResource IconPath}" Data="M8 7L12 3L16 7 M12 3V21 M8 17L12 21L16 17 M3 9V15 M21 9V15"
                          Width="14" Height="14" Stroke="{Binding TerminalScrollable, Converter={StaticResource ViewStroke}, ConverterParameter=True}"/>
                  </Button>
                  <Button Width="24" Height="24" Command="{Binding ToggleTerminalHorizontalScrollableCommand}" AutomationProperties.Name="Horizontal terminal scrolling">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="ToolTip" Value="Horizontal scrolling: off — enable to resize columns independently"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding TerminalHorizontalScrollable}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="ToolTip" Value="Horizontal scrolling: on — disable to fit columns to screen width"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <Path Style="{StaticResource IconPath}" Data="M7 8L3 12L7 16 M3 12H21 M17 8L21 12L17 16 M9 3H15 M9 21H15"
                          Width="14" Height="14" Stroke="{Binding TerminalHorizontalScrollable, Converter={StaticResource ViewStroke}, ConverterParameter=True}"/>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Automatic split layout" Command="{Binding SetSplitColumnsCommand}" CommandParameter="0" Content="A" FontSize="11"/>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="One split column" Command="{Binding SetSplitColumnsCommand}" CommandParameter="1" Content="1" FontSize="11"/>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Two split columns" Command="{Binding SetSplitColumnsCommand}" CommandParameter="2" Content="2" FontSize="11"/>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Three split columns" Command="{Binding SetSplitColumnsCommand}" CommandParameter="3" Content="3" FontSize="11"/>
                  </StackPanel>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Fullscreen terminal" Command="{Binding ToggleTerminalMaxCommand}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGrid}" Width="12" Height="12" Stroke="{Binding TerminalMaximized, Converter={StaticResource ViewStroke}, ConverterParameter=True}"/>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Copy output" Command="{Binding CopyOutputCommand}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}" Width="12" Height="12"/>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="24" Height="24" ToolTip="Clear output" Command="{Binding ClearOutputCommand}">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTrash}" Width="12" Height="12"/>
                  </Button>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}"/>

        <!-- ===== DETAILS PANEL ===== -->
        <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="46"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="18,0,10,0">
              <TextBlock Text="Details" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
              <Button Style="{StaticResource IconButton}" Width="30" Height="30" HorizontalAlignment="Right" ToolTip="Hide details"
                      Command="{Binding ToggleDetailsCommand}">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="15" Height="15"/>
              </Button>
            </Grid>
            <controls:ProjectInspector Grid.Row="1"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ STATUS BAR ============ -->
      <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="14,0,10,0">
          <!-- The page header already says how many are shown; the status bar reports the whole
               library instead, so the two lines aren't the same number twice. -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource MutedText}" FontSize="11.5"/>
            <Border Width="1" Height="12" Background="{StaticResource BorderBrush}" Margin="12,0"
                    Visibility="{Binding RunningBadge, Converter={StaticResource EmptyVis}}"/>
            <StackPanel Orientation="Horizontal" Visibility="{Binding RunningBadge, Converter={StaticResource EmptyVis}}">
              <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontSize="11.5">
                <Run Text="{Binding RunningCount, Mode=OneWay}"/><Run Text=" running"/>
              </TextBlock>
            </StackPanel>
          </StackPanel>
          <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Toggle terminal"
                  Command="{Binding ToggleTerminalCommand}">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTerminal}" Width="13" Height="13"
                  Stroke="{Binding TerminalOpen, Converter={StaticResource ViewStroke}, ConverterParameter=True}"/>
          </Button>
        </Grid>
      </Border>

      <!-- ============ DOC READER MODAL ============ -->
      <Grid Grid.RowSpan="3" Visibility="{Binding ReaderOpen, Converter={StaticResource BoolVis}}">
        <Border Background="#B3000000" MouseLeftButtonDown="ReaderOverlay_MouseLeftButtonDown">
          <Border MaxWidth="880" MaxHeight="760" Margin="60,40" Padding="24,20,10,20"
                  Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14"
                  MouseLeftButtonDown="ReaderModal_MouseLeftButtonDown">
            <Border.Effect>
              <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Grid Margin="0,0,14,14">
                <TextBlock Text="{Binding ReaderTitle}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Command="{Binding OpenReaderFileCommand}" Padding="12,8" Margin="0,0,8,0" ToolTip="Open this file in your editor">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCode}" Width="13" Height="13"/>
                      <TextBlock Text="Open in editor" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="32" Height="32" Command="{Binding CloseReaderCommand}" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Width="12" Height="12" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
                  </Button>
                </StackPanel>
              </Grid>

              <!-- Tabs -->
              <StackPanel Grid.Row="1" Margin="0,0,14,14">
                <ItemsControl ItemsSource="{Binding ReaderTabs}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="0,0,7,0" Padding="14,7"
                              Command="{Binding DataContext.SetReaderTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="{Binding}" FontSize="12.5">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Value="True">
                                  <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EqualsMulti}">
                                      <Binding/>
                                      <Binding Path="DataContext.ReaderTab" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </MultiBinding>
                                  </DataTrigger.Binding>
                                  <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ReaderSubtitle}" Style="{StaticResource MutedText}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                           Margin="2,10,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <Grid Grid.Row="2">
                <!-- State-doc prose is read as a small set of focused notes. -->
                <Grid Visibility="{Binding IsReaderNotes, Converter={StaticResource BoolVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="148"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Border Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                          BorderThickness="1" CornerRadius="9" Padding="6">
                    <ItemsControl ItemsSource="{Binding ReaderNoteSections}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Padding="10,8" Margin="0,0,0,3" HorizontalContentAlignment="Left"
                                  Command="{Binding DataContext.SetReaderNoteSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}">
                            <TextBlock Text="{Binding}" FontSize="12">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Value="True">
                                      <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource EqualsMulti}">
                                          <Binding/>
                                          <Binding Path="DataContext.ReaderNoteSection" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                      </DataTrigger.Binding>
                                      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                      <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>

                  <controls:MarkdownViewer Grid.Column="2" Markdown="{Binding ReaderText}" BasePath="{Binding ReaderBasePath}"/>
                </Grid>

                <controls:MarkdownViewer Markdown="{Binding ReaderText}" BasePath="{Binding ReaderBasePath}"
                                         Visibility="{Binding IsReaderNotes, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
              </Grid>
            </Grid>
          </Border>
        </Border>
      </Grid>

      <!-- ============ DOC FIELD EDITOR MODAL ============ -->
      <Grid Grid.RowSpan="3" Visibility="{Binding FieldEditorOpen, Converter={StaticResource BoolVis}}">
        <Border Background="#B3000000" MouseLeftButtonDown="FieldEditorOverlay_MouseLeftButtonDown">
          <Border MaxWidth="760" MaxHeight="640" Margin="80,60" Padding="24,20,10,20"
                  Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14"
                  MouseLeftButtonDown="FieldEditorModal_MouseLeftButtonDown">
            <Border.Effect>
              <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Grid Margin="0,0,14,14">
                <TextBlock Text="{Binding FieldEditorLabel}" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,4,0"
                          Command="{Binding GenerateDocFieldCommand}" CommandParameter="{Binding FieldEditorLabel}"
                          ToolTip="Generate from the project's code with AI">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconStar}" Width="14" Height="14"/>
                  </Button>
                  <Button Style="{StaticResource IconButton}" Width="32" Height="32" Command="{Binding CloseFieldEditorCommand}" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Width="12" Height="12" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
                  </Button>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,14,14">
                <ItemsControl ItemsSource="{x:Static vm:MainViewModel.FieldEditorModes}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Margin="0,0,7,0" Padding="14,7"
                              Command="{Binding DataContext.SetFieldEditorModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="{Binding}" FontSize="12.5">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Value="True">
                                  <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource EqualsMulti}">
                                      <Binding/>
                                      <Binding Path="DataContext.FieldEditorMode" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </MultiBinding>
                                  </DataTrigger.Binding>
                                  <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                  <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Grid Grid.Row="2">
                <TextBox Text="{Binding FieldEditorText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0,0,10,0" FontSize="13"
                         Visibility="{Binding FieldEditorMode, Converter={StaticResource PageVis}, ConverterParameter=Edit}"/>
                <controls:MarkdownViewer Markdown="{Binding FieldEditorText}"
                                          Visibility="{Binding FieldEditorMode, Converter={StaticResource PageVis}, ConverterParameter=Preview}"/>
              </Grid>
            </Grid>
          </Border>
        </Border>
      </Grid>

      <!-- ============ CONFIRM DIALOG ============ -->
      <Grid Grid.RowSpan="3" Visibility="{Binding DialogOpen, Converter={StaticResource BoolVis}}">
        <Border Background="#B3000000" MouseLeftButtonDown="DialogOverlay_MouseLeftButtonDown">
          <Border MaxWidth="460" MinWidth="360" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26,24,26,22"
                  Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14"
                  MouseLeftButtonDown="DialogModal_MouseLeftButtonDown">
            <Border.Effect>
              <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="{Binding DialogTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="{Binding DialogMessage}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="19"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="{Binding DialogCancelText}" Command="{Binding DialogCancelCommand}" Padding="16,8" MinWidth="90"/>
                <Button Content="{Binding DialogConfirmText}" Command="{Binding DialogConfirmCommand}" Style="{StaticResource PrimaryButton}"
                        Padding="16,8" MinWidth="90" Margin="10,0,0,0"
                        Visibility="{Binding DialogDanger, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
                <Button Content="{Binding DialogConfirmText}" Command="{Binding DialogConfirmCommand}" Style="{StaticResource DangerButton}"
                        Padding="16,8" MinWidth="90" Margin="10,0,0,0"
                        Visibility="{Binding DialogDanger, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
