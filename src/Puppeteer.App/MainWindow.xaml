<Window x:Class="Puppeteer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Puppeteer.App.Controls"
        xmlns:vm="clr-namespace:Puppeteer.App.ViewModels"
        Title="Puppeteer" Width="1600" Height="900" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        Icon="Assets/icon.png" WindowStyle="None" ResizeMode="CanResize" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="BareList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
      <Setter Property="Width" Value="5"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
    </Style>

    <!-- One terminal pane: prompt + output + input. Data context is a TerminalSessionViewModel. -->
    <DataTemplate x:Key="TerminalPane" DataType="{x:Type vm:TerminalSessionViewModel}">
      <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Margin="4" Background="{StaticResource TerminalBgBrush}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock Text="exited" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                           Visibility="{Binding Running, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
              </StackPanel>
              <Button Style="{StaticResource IconButton}" Width="18" Height="18" HorizontalAlignment="Right" ToolTip="Close"
                      Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
              </Button>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,10" ScrollChanged="TerminalOutput_ScrollChanged">
            <StackPanel>
              <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,0,0,4">
                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TerminalGreenBrush}" FontWeight="Bold"/><Run Text=":" Foreground="{StaticResource MutedTextBrush}"/><Run Text="{Binding ProjectPath, Mode=OneWay}" Foreground="{StaticResource TerminalCyanBrush}"/>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Output}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource TerminalGreenBrush}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="›" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Grid.Column="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Running}"
                       Background="Transparent" BorderThickness="0" Padding="0" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                       VerticalContentAlignment="Center" KeyDown="TerminalInput_KeyDown"/>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ============ FULL-WIDTH TITLE BAR ============ -->
      <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="14,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- Logo -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
            <Image Source="Assets/icon.png" Width="30" Height="30"/>
            <TextBlock Text="Puppeteer" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
          <!-- Sidebar toggle -->
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="36" Height="36" Margin="8,0,0,0" ToolTip="Toggle sidebar"
                  Command="{Binding ToggleSidebarCommand}">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconList}" Width="17" Height="17"/>
          </Button>
          <!-- Search -->
          <Border Grid.Column="2" MaxWidth="480" HorizontalAlignment="Left" Height="38" Margin="16,0,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Width="480">
            <Grid Margin="12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Path Grid.Column="0" Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}" Width="15" Height="15" Stroke="{StaticResource MutedTextBrush}"/>
              <Grid Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Search projects..." Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" FontSize="13"
                           Visibility="{Binding Search, Converter={StaticResource EmptyVis}, ConverterParameter=Inverse}" IsHitTestVisible="False"/>
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center"/>
              </Grid>
              <Border Grid.Column="2" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="⌘K" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
              </Border>
            </Grid>
          </Border>
          <!-- Actions + window caption -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding AddRootCommand}" Height="38" Padding="15,0">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}"/>
                <TextBlock Text="Add Root" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="38" Height="38" Margin="9,0,0,0" ToolTip="Rescan all roots"
                    Command="{Binding RescanCommand}">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconRefresh}" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Width="38" Height="38" Margin="4,0,0,0" ToolTip="Toggle details panel"
                    Command="{Binding ToggleDetailsCommand}">
              <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSplit}" Width="16" Height="16"/>
            </Button>
            <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="10,0,4,0"/>
            <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize">
              <Rectangle Width="11" Height="1.4" Fill="{StaticResource MutedTextBrush}"/>
            </Button>
            <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize">
              <Rectangle Width="10" Height="10" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.4" Fill="Transparent"/>
            </Button>
            <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Close">
              <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ CONTENT (below the title bar) ============ -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="230" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="380"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition x:Name="DetailsColumn" Width="346" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Nav -->
            <StackPanel Grid.Row="0" Margin="13,16,13,0">
              <controls:SidebarItem Icon="{StaticResource IconFolder}" Label="Projects"
                                    IsActive="{Binding CurrentPage, Converter={StaticResource PageActive}, ConverterParameter=Projects}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Projects"/>
              <controls:SidebarItem Icon="{StaticResource IconActivity}" Label="Running" ShowDot="True" Badge="{Binding RunningBadge}"
                                    IsActive="{Binding CurrentPage, Converter={StaticResource PageActive}, ConverterParameter=Running}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Running"/>
              <controls:SidebarItem Icon="{StaticResource IconPlusCircle}" Label="Add Root"
                                    Command="{Binding AddRootCommand}"/>
              <controls:SidebarItem Icon="{StaticResource IconSettings}" Label="Settings"
                                    IsActive="{Binding CurrentPage, Converter={StaticResource PageActive}, ConverterParameter=Settings}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
            </StackPanel>
            <!-- Folder tree -->
            <Grid Grid.Row="1" Margin="13,18,8,0" Visibility="{Binding FolderTree.Count, Converter={StaticResource CountVis}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Margin="5,0,5,6">
                <TextBlock Text="FOLDERS" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource CardLinkButton}" Content="Clear" FontSize="11"
                        Command="{Binding ClearFolderCommand}"
                        Visibility="{Binding FolderFilterActive, Converter={StaticResource BoolVis}}"/>
              </Grid>
              <TreeView Grid.Row="1" ItemsSource="{Binding FolderTree}" Background="Transparent" BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                  <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="False"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                  </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                  <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Button Style="{StaticResource CardLinkButton}" HorizontalContentAlignment="Left" Padding="3,3"
                            Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                            CommandParameter="{Binding}" ToolTip="{Binding Path}">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolder}" Width="13" Height="13" Stroke="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProjectCount}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource FaintBrush}"/>
                      </StackPanel>
                    </Button>
                  </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </Grid>
            <!-- Bottom running pill -->
            <Border Grid.Row="2" Margin="16,10,16,16" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,9"
                    Visibility="{Binding RunningBadge, Converter={StaticResource EmptyVis}}" Cursor="Hand"
                    MouseLeftButtonUp="RunningPill_Click">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Running" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock Text="{Binding RunningCount}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                  <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="13" Height="13" Margin="8,0,0,0" Stroke="{StaticResource FaintBrush}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>

        <!-- ===== MAIN COLUMN ===== -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="PagesRow" Height="*"/>
            <RowDefinition x:Name="TerminalSplitterRow" Height="0"/>
            <RowDefinition x:Name="TerminalRow" Height="0"/>
          </Grid.RowDefinitions>

          <!-- ===== PAGES ===== -->
          <Grid Grid.Row="0">
            <!-- Projects page -->
            <Grid Margin="26,20,26,0" Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Projects}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Projects" Style="{StaticResource PageTitle}"/>
                <TextBlock VerticalAlignment="Center" Margin="14,8,0,0" Style="{StaticResource MutedText}">
                  <Run Text="{Binding Projects.Count, Mode=OneWay}"/><Run Text=" shown"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="Scanning…" Foreground="{StaticResource AccentBrush}" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Background="{StaticResource ChipBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,3" Margin="14,6,0,0" VerticalAlignment="Center"
                        Visibility="{Binding FolderFilterActive, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectedFolder.Name}" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Width="16" Height="16" Margin="7,0,0,0" Command="{Binding ClearFolderCommand}" ToolTip="Clear folder filter">
                      <Path Data="{StaticResource IconClose}" Width="8" Height="8" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
              <!-- Filter dropdowns + view toggle -->
              <Grid Grid.Row="1" Margin="0,18,0,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Type" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Width="150" Height="36"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Technology" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding TechnologyOptions}" SelectedItem="{Binding SelectedTechnology}" Width="150" Height="36"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Category" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Width="150" Height="36"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Sort" Style="{StaticResource MutedText}" FontSize="11" Margin="2,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" Width="130" Height="36"/>
                  </StackPanel>
                  <Border VerticalAlignment="Bottom" Height="36" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                      <Button Command="{Binding SetViewCommand}" CommandParameter="Grid" Style="{StaticResource ViewToggleButton}" ToolTip="Grid view" Margin="0,0,2,0">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGrid}" Width="15" Height="15" Stroke="{Binding ViewMode, Converter={StaticResource ViewStroke}, ConverterParameter=Grid}"/>
                      </Button>
                      <Button Command="{Binding SetViewCommand}" CommandParameter="List" Style="{StaticResource ViewToggleButton}" ToolTip="List view">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconList}" Width="15" Height="15" Stroke="{Binding ViewMode, Converter={StaticResource ViewStroke}, ConverterParameter=List}"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
              <ListBox Grid.Row="2" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="0,0,0,120"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                       VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.Style>
                  <Style TargetType="ListBox" BasedOn="{StaticResource BareList}">
                    <Setter Property="ItemsPanel">
                      <Setter.Value>
                        <ItemsPanelTemplate><controls:VirtualizingWrapPanel ItemWidth="316" ItemHeight="182"/></ItemsPanelTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ViewMode}" Value="List">
                        <Setter Property="ItemsPanel">
                          <Setter.Value>
                            <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                  <DataTemplate><controls:ProjectCard/></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                          Visibility="{Binding Projects.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolder}" Width="30" Height="30" Stroke="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No projects yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock Text="Add a root folder to scan for projects. Puppeteer detects .NET, Tauri, Flutter, Next.js, Rust, and more."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16"/>
                <Button Command="{Binding AddRootCommand}" HorizontalAlignment="Center" Padding="16,10">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="15" Height="15" Stroke="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Add Root" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Running page -->
            <Grid Margin="26,20,26,22" Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Running}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Running" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>
              <ListBox Grid.Row="1" Style="{StaticResource BareList}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource PanelCard}" Padding="16" Margin="0,0,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Accent}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                          <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" FontSize="14.5"/>
                          <TextBlock Text="{Binding Command}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="running" Foreground="{StaticResource SuccessBrush}"
                                   Visibility="{Binding Running, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Text="exited" Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding Running, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <!-- Settings page -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Settings}">
              <StackPanel Margin="26,20,26,22">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,4"/>
                <TextBlock Text="Manage roots, terminal, and detection." Style="{StaticResource MutedText}" Margin="0,0,0,22"/>

                <TextBlock Text="Roots" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Roots}" Margin="0,0,0,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource PanelCard}" Padding="14" Margin="0,0,0,8">
                        <Grid>
                          <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolder}" Width="16" Height="16" Stroke="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Path}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Medium"/>
                          </StackPanel>
                          <Button HorizontalAlignment="Right" Content="Remove"
                                  Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No roots yet — use Add Root to scan a folder." Style="{StaticResource MutedText}" Margin="2,0,0,0"
                           Visibility="{Binding Roots.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}"/>

                <TextBlock Text="Terminal" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <TextBlock Text="Default shell" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Shells}" SelectedItem="{Binding DefaultShell}" Width="340" HorizontalAlignment="Left"/>

                <TextBlock Text="AI categorization (Groq)" Style="{StaticResource SectionTitle}" Margin="0,26,0,6"/>
                <TextBlock Text="Used to label projects as Personal / Client / Hackathon / Course from their README and path. Leave blank to use the .env key in development."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox Text="{Binding GroqApiKey, UpdateSourceTrigger=LostFocus}" Width="440" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Text="Using the key from .env" Style="{StaticResource MutedText}" FontSize="11.5" Foreground="{StaticResource SuccessBrush}" Margin="2,6,0,0"
                           Visibility="{Binding UsingEnvGroqKey, Converter={StaticResource BoolVis}}"/>

                <TextBlock Text="Detection" Style="{StaticResource SectionTitle}" Margin="0,26,0,10"/>
                <TextBlock Text="Tauri · .NET/WPF · Flutter · Next.js · Vite · Node.js · Qt · Android · Rust · Python · Godot"
                           Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
              </StackPanel>
            </ScrollViewer>

            <!-- Status toast -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Panel.ZIndex="10" Margin="0,0,0,26"
                    Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="15,10"
                    Visibility="{Binding StatusVisible, Converter={StaticResource BoolVis}}">
              <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.55" Color="#000000"/></Border.Effect>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Status}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextBrush}"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ===== TERMINAL RESIZE HANDLE ===== -->
          <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{StaticResource BorderStrongBrush}" Cursor="SizeNS" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                        DragCompleted="TerminalSplitter_DragCompleted"/>

          <!-- ===== TERMINAL ===== -->
          <Border Grid.Row="2" Background="{StaticResource TerminalBgBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <!-- Header -->
              <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="10,0,10,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding CollapseTerminalCommand}" ToolTip="Collapse">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronDown}" Width="15" Height="15"/>
                    </Button>
                    <TextBlock Text="Terminal" Margin="6,0,10,0" VerticalAlignment="Center" FontWeight="Medium" FontSize="12.5"/>
                    <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" VerticalAlignment="Center" Background="Transparent">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Margin" Value="3,0"/>
                          <Setter Property="Cursor" Value="Hand"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="10,5">
                                  <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextDimBrush}"/>
                                    <Button Style="{StaticResource IconButton}" Width="18" Height="18" Margin="7,0,-2,0" ToolTip="Close tab"
                                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                      <Path Data="{StaticResource IconClose}" Width="9" Height="9" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.7" Stretch="Uniform"/>
                                    </Button>
                                  </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                  </Trigger>
                                  <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                    <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="3,0,0,0" ToolTip="New tab"
                            Command="{Binding NewSessionCommand}">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="13" Height="13"/>
                    </Button>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Shells}" SelectedItem="{Binding DefaultShell}" Width="140" Height="30"/>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0" ToolTip="New shell"
                            Command="{Binding NewSessionCommand}">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTerminal}" Width="15" Height="15"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Split panes (show all shells side by side)"
                            Command="{Binding ToggleSplitCommand}">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSplit}" Width="15" Height="15"
                            Stroke="{Binding TerminalSplit, Converter={StaticResource ViewStroke}, ConverterParameter=True}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Fullscreen terminal"
                            Command="{Binding ToggleTerminalMaxCommand}">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGrid}" Width="15" Height="15"
                            Stroke="{Binding TerminalMaximized, Converter={StaticResource ViewStroke}, ConverterParameter=True}"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Clear output"
                            Command="{Binding ClearOutputCommand}">
                      <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTrash}" Width="15" Height="15"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
              <!-- Body: single pane or split grid -->
              <Grid Grid.Row="1">
                <TextBlock Text="No terminal open. Select a project and press Open Terminal." Style="{StaticResource MutedText}" Margin="16,12,0,0"
                           Visibility="{Binding SelectedSession, Converter={StaticResource NullVis}, ConverterParameter=Inverse}"/>
                <ContentControl Content="{Binding SelectedSession}" ContentTemplate="{StaticResource TerminalPane}"
                                Visibility="{Binding TerminalSplit, Converter={StaticResource BoolVis}, ConverterParameter=Inverse}"/>
                <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource TerminalPane}"
                              Visibility="{Binding TerminalSplit, Converter={StaticResource BoolVis}}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}"/>

        <!-- ===== DETAILS PANEL ===== -->
        <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="46"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="18,0,10,0">
              <TextBlock Text="Details" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
              <Button Style="{StaticResource IconButton}" Width="30" Height="30" HorizontalAlignment="Right" ToolTip="Hide details"
                      Command="{Binding ToggleDetailsCommand}">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChevronRight}" Width="15" Height="15"/>
              </Button>
            </Grid>
            <controls:ProjectInspector Grid.Row="1"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
